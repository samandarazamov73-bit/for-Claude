# Обязательные
TELEGRAM_TOKEN=
ADMIN_TOKEN=
ADMIN_CHAT_ID=
GEMINI_API_KEY=
CARD_NUMBER=
CARD_NAME=

# Необязательные (значения по умолчанию указаны справа)
# SUPPORT_HANDLE=@Umstveniy
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API=studio         studio = ключ из Google AI Studio, vertex = ключ Vertex AI (без строки бот выберет сам)
# HOME_LANES=2              параллельных проверщиков на этом IP (1 = один, как раньше)
# PENDING_ALERTS=1          0 = не слать объявления, пока OLX их проверяет
# CACHE_BUST=1              0 = не добавлять ?_=время к запросам OLX
# LIST_INTERVAL_SEC=30      как часто читать списки категорий
# ALLOW_AGENCIES=0          1 = брать и агентства (бизнес-аккаунты OLX), с пометкой «Риелтор»
# ALLOW_COMMISSION=0        1 = брать и объявления с комиссией, с пометкой «Риелтор»
# RENT_PRICE_MIN_SUM=1500000  нижний порог цены аренды в сумах (0 = и комнаты, и подселение)
# MAX_PUBLISHED_SEC=60      опубликованные объявления — только в первые N секунд после публикации
# FREE_TRIAL=1              0 = выключить пробный доступ для новых пользователей
# FREE_TRIAL_HOURS=3        сколько часов длится пробный доступ (один раз на человека)
# TEST_MODE=0               1 = тестовый бот: всё работает, но напоминания не отправляются
