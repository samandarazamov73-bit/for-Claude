; Engine configuration file.
; Godot 4.7

config_version=5

[application]

config/name="The Last Shake v4"
config/description="Психологический инди-хоррор: автобус через лес, заброшенный санаторий «Оромгох», 1975 год."
run/main_scene="res://story/menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GraphicsSettings="*res://scripts/graphics_settings.gd"
GameState="*res://story/game_state.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://sanatorium/assets/fonts/NotoSans.ttf"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true
common/physics_jitter_fix=0.0

[rendering]

rendering_device/driver.macos="metal"
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.lowend="mobile"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=3
occlusion_culling/use_occlusion_culling=true
occlusion_culling/occluder_ray_tracing_quality=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/atlas_size=4096
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_debanding=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
mesh_lod/lod_change/threshold_pixels=1.5
limits/global_shader_variables/buffer_size=262144

[shader_globals]

main_camera_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
wind={
"type": "vec4",
"value": Vector4(0.8, 0.6, 0.6, 1)
}
world_rect={
"type": "vec4",
"value": Vector4(-1024, -1024, 2049, 2049)
}
terrain_height={
"type": "sampler2D",
"value": ""
}
terrain_normal={
"type": "sampler2D",
"value": "res://resources/world/terrain_normal.png"
}
world_control1={
"type": "sampler2D",
"value": "res://resources/world/control1.png"
}
wetness={
"type": "float",
"value": 0.55
}
shadow_coarse={
"type": "bool",
"value": false
}
debug_lod={
"type": "bool",
"value": false
}
far_shadow={
"type": "vec2",
"value": Vector2(110, 150)
}
